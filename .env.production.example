# ==============================================================================
# COLLEGE OS - Environment Configuration Template
# ==============================================================================
# IMPORTANT: NEVER commit real credentials or secrets to version control.
# Copy this file to .env (or .env.development / .env.production) and fill in values.
# ==============================================================================

# Application Configuration
APP_NAME=CollegeOS
APP_ENV=development
APP_PORT=4000
APP_VERSION=0.1.0
APP_URL=http://localhost:4000
API_PREFIX=/api/v1

# Multi-Tenancy & College Identity
DEFAULT_INSTITUTION_ID=00000000-0000-0000-0000-000000000001
DEFAULT_INSTITUTION_SLUG=demo-university

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://collegeos_user:collegeos_password@localhost:5432/collegeos_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=none
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false

# Security & Authentication (Placeholders - MUST change in production)
JWT_ACCESS_SECRET=CHANGE_ME_IN_PRODUCTION_MIN_32_CHAR_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION_REFRESH_SECRET_KEY
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12

# CORS Configuration (Comma-separated origins, no trailing slash, no wildcard in prod)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Rate Limiting Configuration
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging & Observability
LOG_LEVEL=debug
LOG_FORMAT=json

# Storage Configuration (S3 / Local placeholder)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_S3_BUCKET=none
STORAGE_S3_REGION=none
STORAGE_S3_ACCESS_KEY=none
STORAGE_S3_SECRET_KEY=none

# Android Client BuildConfig Settings
ANDROID_API_BASE_URL=http://10.0.2.2:4000/api/v1/
ANDROID_CONNECT_TIMEOUT_SEC=15
ANDROID_READ_TIMEOUT_SEC=20
