# ==============================================================================
# COLLEGE OS - Production Environment Configuration Template
# ==============================================================================
# Strict Rule: Supply all values via secure secrets manager (e.g. AWS Secrets Manager / Vault).
# ==============================================================================
APP_NAME=CollegeOS
APP_ENV=production
APP_PORT=4000
APP_VERSION=0.1.0
APP_URL=https://api.collegeos.internal
API_PREFIX=/api/v1

DATABASE_URL=postgresql://USER:PASSWORD@postgres-cluster.internal:5432/collegeos_prod?sslmode=require
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=25

REDIS_URL=rediss://:PASSWORD@redis-cluster.internal:6379
REDIS_REQUIRED=true

JWT_ACCESS_SECRET=CHANGE_ME_TO_STRONG_64_CHAR_KEY
JWT_REFRESH_SECRET=CHANGE_ME_TO_STRONG_64_CHAR_KEY
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12

# Explicit production origins only - NO WILDCARDS
CORS_ORIGINS=https://admin.collegeos.edu,https://app.collegeos.edu
LOG_LEVEL=info
LOG_FORMAT=json

STORAGE_DRIVER=s3
STORAGE_S3_BUCKET=college-os-production-assets
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=CHANGE_ME
STORAGE_S3_SECRET_KEY=CHANGE_ME

ANDROID_API_BASE_URL=https://api.collegeos.edu/api/v1/
