// ==============================================================================
// COLLEGE OS - Prisma Database Schema (Phase 5 Production Social OS)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstitutionStatus {
  ACTIVE
  SUSPENDED
  PENDING
  ARCHIVED
}

enum InstitutionType {
  UNIVERSITY
  COLLEGE
  INSTITUTE
  SCHOOL
  OTHER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  LOCKED
}

enum MembershipStatus {
  INVITED
  PENDING
  ACTIVE
  SUSPENDED
  REMOVED
}

enum IntegrationType {
  API_KEY
  OAUTH2
  OIDC
  SAML
  SERVICE_ACCOUNT
  WEBHOOK
  FILE_IMPORT
  MANUAL_IMPORT
}

enum IntegrationStatus {
  PENDING
  CONNECTING
  CONNECTED
  SYNCING
  PAUSED
  ERROR
  DISCONNECTED
}

enum SyncJobType {
  FULL_SYNC
  INCREMENTAL_SYNC
  ENTITY_SYNC
  MANUAL_SYNC
  SCHEDULED_SYNC
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum SyncOperation {
  CREATE
  UPDATE
  SKIP
  DELETE
  LINK
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  OTHER
}

enum ExamType {
  INTERNAL
  MIDTERM
  END_SEMESTER
  PRACTICAL
  QUIZ
  OTHER
}

enum SubjectType {
  CORE
  ELECTIVE
  LAB
  PROJECT
  OTHER
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum ResourceType {
  DOCUMENT
  VIDEO
  LINK
  PRESENTATION
  IMAGE
  OTHER
}

enum ResourceVisibility {
  ENROLLED_STUDENTS
  SECTION
  DEPARTMENT
  INSTITUTION
}

enum CalendarEventType {
  CLASS
  EXAM
  HOLIDAY
  ACADEMIC_EVENT
  DEADLINE
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AnnouncementAudience {
  SECTION
  PROGRAM
  DEPARTMENT
  INSTITUTION
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  LINK
  POLL
}

enum PostVisibility {
  PRIVATE
  CONNECTIONS
  SECTION
  DEPARTMENT
  COLLEGE
  COMMUNITY
  CLUB
}

enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  REMOVED
  ARCHIVED
}

enum CommunityVisibility {
  PUBLIC_WITHIN_COLLEGE
  PRIVATE
  INVITE_ONLY
}

enum CommunityMemberRole {
  MEMBER
  MODERATOR
  OWNER
}

enum CommunityMemberStatus {
  PENDING
  MEMBER
  MODERATOR
  OWNER
  BANNED
}

enum ClubStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ClubRole {
  MEMBER
  SECRETARY
  TREASURER
  EVENT_MANAGER
  SOCIAL_MEDIA_MANAGER
  PRESIDENT
  FACULTY_ADVISOR
}

enum EventParticipationStatus {
  INTERESTED
  GOING
  WAITLISTED
  CANCELLED
}

enum ReportReason {
  SPAM
  HARASSMENT
  BULLYING
  HATE
  SEXUAL_CONTENT
  VIOLENCE
  IMPERSONATION
  MISINFORMATION
  SCAM
  PRIVACY
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  REMOVE_CONTENT
  WARN_USER
  RESTRICT_USER
  SUSPEND_USER
  BAN_USER
}

// ------------------------------------------------------------------------------
// Institution (Tenant Root)
// ------------------------------------------------------------------------------
model Institution {
  id            String            @id @default(uuid()) @db.Uuid
  name          String            @db.VarChar(255)
  slug          String            @unique @db.VarChar(100)
  legalName     String?           @map("legal_name") @db.VarChar(255)
  primaryDomain String?           @map("primary_domain") @db.VarChar(255)
  logoUrl       String?           @map("logo_url") @db.VarChar(500)
  type          InstitutionType   @default(COLLEGE)
  status        InstitutionStatus @default(ACTIVE)
  settings      Json?             @default("{}")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  memberships      InstitutionMembership[]
  roles            Role[]
  auditLogs        AuditLog[]
  securityEvents    SecurityEvent[]
  sessions         Session[]

  integrations     InstitutionIntegration[]
  academicYears    AcademicYear[]
  semesters        Semester[]
  departments      Department[]
  programs         Program[]
  courses          Course[]
  subjects         Subject[]
  sections         Section[]
  studentProfiles  StudentProfile[]
  facultyProfiles  FacultyProfile[]
  enrollments      Enrollment[]
  timetables       TimetableEntry[]
  attendanceRecords AttendanceRecord[]
  exams            Exam[]
  results          Result[]
  syncJobs         SyncJob[]
  syncConflicts    SyncConflict[]

  assignments      Assignment[]
  resources        CourseResource[]
  announcements    AcademicAnnouncement[]
  calendarEvents   AcademicCalendarEvent[]

  posts            Post[]
  communities      Community[]
  clubs            Club[]
  events           Event[]
  reports          Report[]

  @@index([status])
  @@index([slug])
  @@map("institutions")
}

// ------------------------------------------------------------------------------
// User (Global Identity)
// ------------------------------------------------------------------------------
model User {
  id              String      @id @default(uuid()) @db.Uuid
  email           String      @unique @db.VarChar(255)
  phone           String?     @db.VarChar(50)
  passwordHash    String      @map("password_hash") @db.VarChar(255)
  firstName       String      @map("first_name") @db.VarChar(100)
  lastName        String      @map("last_name") @db.VarChar(100)
  displayName     String?     @map("display_name") @db.VarChar(200)
  profileImageUrl String?     @map("profile_image_url") @db.VarChar(500)
  status          UserStatus  @default(PENDING)

  emailVerifiedAt DateTime?   @map("email_verified_at") @db.Timestamptz
  phoneVerifiedAt DateTime?   @map("phone_verified_at") @db.Timestamptz
  lastLoginAt     DateTime?   @map("last_login_at") @db.Timestamptz
  lockedAt        DateTime?   @map("locked_at") @db.Timestamptz
  lockReason      String?     @map("lock_reason") @db.VarChar(255)
  lockExpiresAt   DateTime?   @map("lock_expires_at") @db.Timestamptz

  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  memberships            InstitutionMembership[]
  sessions               Session[]
  auditLogs              AuditLog[]
  securityEvents         SecurityEvent[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  externalIdentities     ExternalIdentity[]
  studentProfile         StudentProfile?
  facultyProfile         FacultyProfile?

  studyTasks             StudyTask[]
  academicGoals          AcademicGoal[]
  academicNotes          AcademicNote[]
  announcementsAuthored  AcademicAnnouncement[]

  socialProfile          SocialProfile?
  posts                  Post[]
  likes                  PostLike[]
  comments               Comment[]
  savedPosts             SavedPost[]
  following              Follow[]                 @relation("Follower")
  followers              Follow[]                 @relation("Following")
  sentConnections        Connection[]             @relation("Requester")
  receivedConnections    Connection[]             @relation("Receiver")
  communitiesOwned       Community[]              @relation("CommunityOwner")
  communityMemberships   CommunityMembership[]
  clubMemberships        ClubMembership[]
  eventsOrganized        Event[]                  @relation("EventOrganizer")
  eventRegistrations     EventRegistration[]
  messagesSent           Message[]                @relation("MessageSender")
  conversationMemberships ConversationMember[]
  blocksInitiated        Block[]                  @relation("Blocker")
  blocksReceived         Block[]                  @relation("Blocked")
  reportsFiled           Report[]                 @relation("Reporter")
  moderationActions      ModerationAction[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

// ------------------------------------------------------------------------------
// InstitutionMembership
// ------------------------------------------------------------------------------
model InstitutionMembership {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  institutionId String           @map("institution_id") @db.Uuid
  status        MembershipStatus @default(PENDING)
  joinedAt      DateTime?        @map("joined_at") @db.Timestamptz
  leftAt        DateTime?        @map("left_at") @db.Timestamptz
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assignedRoles MembershipRole[]

  @@unique([userId, institutionId])
  @@index([userId])
  @@index([institutionId])
  @@index([status])
  @@map("institution_memberships")
}

// ------------------------------------------------------------------------------
// Role & Permission
// ------------------------------------------------------------------------------
model Role {
  id            String          @id @default(uuid()) @db.Uuid
  institutionId String?         @map("institution_id") @db.Uuid
  name          String          @db.VarChar(100)
  description   String?         @db.VarChar(255)
  isSystemRole  Boolean         @default(false) @map("is_system_role")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  institution   Institution?    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  module      String           @db.VarChar(50)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String                @id @default(uuid()) @db.Uuid
  membershipId String                @map("membership_id") @db.Uuid
  roleId       String                @map("role_id") @db.Uuid
  assignedBy   String?               @map("assigned_by") @db.Uuid
  assignedAt   DateTime              @default(now()) @map("assigned_at") @db.Timestamptz
  expiresAt    DateTime?             @map("expires_at") @db.Timestamptz

  membership   InstitutionMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
  @@map("membership_roles")
}

model Session {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  institutionId   String?      @map("institution_id") @db.Uuid
  refreshTokenHash String       @map("refresh_token_hash") @db.VarChar(255)
  tokenFamilyId    String       @map("token_family_id") @db.VarChar(100)
  deviceId         String?      @map("device_id") @db.VarChar(100)
  deviceName       String?      @map("device_name") @db.VarChar(100)
  platform         String?      @db.VarChar(50)
  userAgent        String?      @map("user_agent") @db.VarChar(500)
  ipAddress        String?      @map("ip_address") @db.VarChar(45)
  lastUsedAt       DateTime     @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt        DateTime     @map("expires_at") @db.Timestamptz
  revokedAt        DateTime?    @map("revoked_at") @db.Timestamptz
  revokeReason     String?      @map("revoke_reason") @db.VarChar(255)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution      Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tokenFamilyId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id            String       @id @default(uuid()) @db.Uuid
  institutionId String?      @map("institution_id") @db.Uuid
  actorUserId   String?      @map("actor_user_id") @db.Uuid
  action        String       @db.VarChar(100)
  resourceType  String       @map("resource_type") @db.VarChar(100)
  resourceId    String?      @map("resource_id") @db.VarChar(100)
  metadata      Json?        @default("{}")
  ipAddress     String?      @map("ip_address") @db.VarChar(45)
  userAgent     String?      @map("user_agent") @db.VarChar(500)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  actorUser     User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([actorUserId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String?      @map("user_id") @db.Uuid
  institutionId String?      @map("institution_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(100)
  ipAddress     String?      @map("ip_address") @db.VarChar(45)
  userAgent     String?      @map("user_agent") @db.VarChar(500)
  metadata      Json?        @default("{}")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([institutionId])
  @@index([eventType])
  @@index([createdAt])
  @@map("security_events")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ------------------------------------------------------------------------------
// ERP INTEGRATION MODELS
// ------------------------------------------------------------------------------

model IntegrationProvider {
  id               String          @id @default(uuid()) @db.Uuid
  name             String          @db.VarChar(100)
  vendor           String          @db.VarChar(100)
  version          String          @db.VarChar(20)
  type             IntegrationType
  capabilities     Json
  documentationUrl String?         @map("documentation_url") @db.VarChar(500)
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  integrations     InstitutionIntegration[]
  externalIdentities ExternalIdentity[]

  @@map("integration_providers")
}

model InstitutionIntegration {
  id                   String            @id @default(uuid()) @db.Uuid
  institutionId        String            @map("institution_id") @db.Uuid
  providerId           String            @map("provider_id") @db.Uuid
  connectionType       IntegrationType   @map("connection_type")
  status               IntegrationStatus @default(PENDING)
  secretRef            String?           @map("secret_ref") @db.VarChar(255)
  configuration        Json?             @default("{}")
  lastSuccessfulSyncAt DateTime?         @map("last_successful_sync_at") @db.Timestamptz
  lastAttemptedSyncAt  DateTime?         @map("last_attempted_sync_at") @db.Timestamptz
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  institution          Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  provider             IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  syncJobs             SyncJob[]
  syncCursors          SyncCursor[]
  syncConflicts        SyncConflict[]

  @@unique([institutionId, providerId])
  @@index([institutionId])
  @@index([status])
  @@map("institution_integrations")
}

model ExternalIdentity {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  institutionId String              @map("institution_id") @db.Uuid
  providerId    String?             @map("provider_id") @db.Uuid
  sourceSystem  String              @map("source_system") @db.VarChar(100)
  externalId    String              @map("external_id") @db.VarChar(255)
  externalType  String              @map("external_type") @db.VarChar(50)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      IntegrationProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@unique([institutionId, sourceSystem, externalId])
  @@index([userId])
  @@index([externalId])
  @@map("external_identities")
}

// ------------------------------------------------------------------------------
// ACADEMIC DOMAIN MODELS
// ------------------------------------------------------------------------------

model AcademicYear {
  id            String       @id @default(uuid()) @db.Uuid
  institutionId String       @map("institution_id") @db.Uuid
  externalId    String?      @map("external_id") @db.VarChar(255)
  name          String       @db.VarChar(100)
  startDate     DateTime     @map("start_date") @db.Date
  endDate       DateTime     @map("end_date") @db.Date
  isCurrent     Boolean      @default(false) @map("is_current")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  semesters     Semester[]
  sections      Section[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("academic_years")
}

model Semester {
  id             String       @id @default(uuid()) @db.Uuid
  institutionId  String       @map("institution_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  externalId     String?      @map("external_id") @db.VarChar(255)
  name           String       @db.VarChar(100)
  semesterNumber Int          @map("semester_number")
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  institution    Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subjects       Subject[]
  sections       Section[]
  enrollments    Enrollment[]

  @@unique([institutionId, academicYearId, semesterNumber])
  @@index([institutionId])
  @@map("semesters")
}

model Department {
  id            String       @id @default(uuid()) @db.Uuid
  institutionId String       @map("institution_id") @db.Uuid
  externalId    String?      @map("external_id") @db.VarChar(255)
  code          String       @db.VarChar(50)
  name          String       @db.VarChar(255)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programs      Program[]
  courses       Course[]
  studentProfiles StudentProfile[]
  facultyProfiles FacultyProfile[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("departments")
}

model Program {
  id            String       @id @default(uuid()) @db.Uuid
  institutionId String       @map("institution_id") @db.Uuid
  departmentId  String       @map("department_id") @db.Uuid
  externalId    String?      @map("external_id") @db.VarChar(255)
  code          String       @db.VarChar(50)
  name          String       @db.VarChar(255)
  degreeType    String       @map("degree_type") @db.VarChar(50)
  durationYears Int          @default(4) @map("duration_years")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department    Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courses       Course[]
  sections      Section[]
  studentProfiles StudentProfile[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("programs")
}

model Course {
  id            String       @id @default(uuid()) @db.Uuid
  institutionId String       @map("institution_id") @db.Uuid
  programId     String       @map("program_id") @db.Uuid
  departmentId  String       @map("department_id") @db.Uuid
  externalId    String?      @map("external_id") @db.VarChar(255)
  code          String       @db.VarChar(50)
  name          String       @db.VarChar(255)
  credits       Int          @default(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  program       Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  department    Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subjects      Subject[]
  enrollments   Enrollment[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("courses")
}

model Subject {
  id            String       @id @default(uuid()) @db.Uuid
  institutionId String       @map("institution_id") @db.Uuid
  courseId      String       @map("course_id") @db.Uuid
  semesterId    String?      @map("semester_id") @db.Uuid
  externalId    String?      @map("external_id") @db.VarChar(255)
  code          String       @db.VarChar(50)
  name          String       @db.VarChar(255)
  type          SubjectType  @default(CORE)
  credits       Int          @default(4)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
