  communityId   String?        @map("community_id") @db.Uuid
  clubId        String?        @map("club_id") @db.Uuid
  eventId       String?        @map("event_id") @db.Uuid
  status        PostStatus     @default(PUBLISHED)
  likesCount    Int            @default(0) @map("likes_count")
  commentsCount Int            @default(0) @map("comments_count")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community     Community?     @relation(fields: [communityId], references: [id], onDelete: SetNull)
  club          Club?          @relation(fields: [clubId], references: [id], onDelete: SetNull)
  event         Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)

  media         PostMedia[]
  likes         PostLike[]
  comments      Comment[]
  savedPosts    SavedPost[]

  @@index([institutionId])
  @@index([authorId])
  @@index([communityId])
  @@index([clubId])
  @@index([createdAt])
  @@map("posts")
}

model PostMedia {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  mediaUrl  String   @map("media_url") @db.VarChar(500)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_media")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("post_likes")
}

model Comment {
  id              String   @id @default(uuid()) @db.Uuid
  postId          String   @map("post_id") @db.Uuid
  authorId        String   @map("author_id") @db.Uuid
  parentCommentId String?  @map("parent_comment_id") @db.Uuid
  content         String   @db.Text
  status          String   @default("PUBLISHED") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment   Comment? @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

model SavedPost {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@map("saved_posts")
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Connection {
  id          String   @id @default(uuid()) @db.Uuid
  requesterId String   @map("requester_id") @db.Uuid
  receiverId  String   @map("receiver_id") @db.Uuid
  status      String   @default("ACCEPTED") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  requester   User     @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User     @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@map("connections")
}

model Community {
  id            String              @id @default(uuid()) @db.Uuid
  institutionId String              @map("institution_id") @db.Uuid
  ownerId       String              @map("owner_id") @db.Uuid
  name          String              @db.VarChar(255)
  description   String              @db.Text
  category      String              @db.VarChar(100)
  visibility    CommunityVisibility @default(PUBLIC_WITHIN_COLLEGE)
  iconUrl       String?             @map("icon_url") @db.VarChar(500)
  coverUrl      String?             @map("cover_url") @db.VarChar(500)
  membersCount  Int                 @default(1) @map("members_count")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  owner         User                @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships   CommunityMembership[]
  posts         Post[]

  @@index([institutionId])
  @@map("communities")
}

model CommunityMembership {
  id          String                @id @default(uuid()) @db.Uuid
  communityId String                @map("community_id") @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  role        CommunityMemberRole   @default(MEMBER)
  status      CommunityMemberStatus @default(MEMBER)
  joinedAt    DateTime              @default(now()) @map("joined_at") @db.Timestamptz

  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
  @@map("community_memberships")
}

model Club {
  id               String          @id @default(uuid()) @db.Uuid
  institutionId    String          @map("institution_id") @db.Uuid
  facultyAdvisorId String?         @map("faculty_advisor_id") @db.Uuid
  name             String          @db.VarChar(255)
  description      String          @db.Text
  category         String          @db.VarChar(100)
  logoUrl          String?         @map("logo_url") @db.VarChar(500)
  status           ClubStatus      @default(PENDING)
  membersCount     Int             @default(0) @map("members_count")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  institution      Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  facultyAdvisor   FacultyProfile? @relation(fields: [facultyAdvisorId], references: [id], onDelete: SetNull)
  memberships      ClubMembership[]
  posts            Post[]
  events           Event[]

  @@index([institutionId])
  @@map("clubs")
}

model ClubMembership {
  id        String   @id @default(uuid()) @db.Uuid
  clubId    String   @map("club_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      ClubRole @default(MEMBER)
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz

  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
  @@map("club_memberships")
}

model Event {
  id            String              @id @default(uuid()) @db.Uuid
  institutionId String              @map("institution_id") @db.Uuid
  organizerId   String              @map("organizer_id") @db.Uuid
  clubId        String?             @map("club_id") @db.Uuid
  title         String              @db.VarChar(255)
  description   String              @db.Text
  startAt       DateTime            @map("start_at") @db.Timestamptz
  endAt         DateTime            @map("end_at") @db.Timestamptz
  location      String              @db.VarChar(255)
  capacity      Int                 @default(100)
  status        String              @default("UPCOMING") @db.VarChar(50)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  organizer     User                @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  club          Club?               @relation(fields: [clubId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]
  posts         Post[]

  @@index([institutionId])
  @@index([startAt])
  @@map("events")
}

model EventRegistration {
  id        String                   @id @default(uuid()) @db.Uuid
  eventId   String                   @map("event_id") @db.Uuid
  userId    String                   @map("user_id") @db.Uuid
  status    EventParticipationStatus @default(GOING)
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  event     Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("event_registrations")
}

model Conversation {
  id            String               @id @default(uuid()) @db.Uuid
  institutionId String               @map("institution_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz

  members       ConversationMember[]
  messages      Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  content        String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id            String             @id @default(uuid()) @db.Uuid
  institutionId String             @map("institution_id") @db.Uuid
  reporterId    String             @map("reporter_id") @db.Uuid
  targetType    String             @map("target_type") @db.VarChar(50) // POST, COMMENT, USER, COMMUNITY, CLUB
  targetId      String             @map("target_id") @db.Uuid
  reason        ReportReason       @default(SPAM)
  description   String?            @db.Text
  status        ReportStatus       @default(OPEN)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt    DateTime?          @map("resolved_at") @db.Timestamptz

  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  reporter      User               @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  actions       ModerationAction[]

  @@index([institutionId])
  @@index([status])
  @@map("reports")
}

model ModerationAction {
  id         String               @id @default(uuid()) @db.Uuid
  reportId   String?              @map("report_id") @db.Uuid
  actorId    String               @map("actor_id") @db.Uuid
  actionType ModerationActionType @map("action_type")
  notes      String?              @db.Text
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz

  report     Report?              @relation(fields: [reportId], references: [id], onDelete: SetNull)
  actor      User                 @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@map("moderation_actions")
}
