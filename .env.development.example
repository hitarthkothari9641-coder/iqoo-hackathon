# ==============================================================================
# COLLEGE OS - Development Environment Configuration
# ==============================================================================
APP_NAME=CollegeOS
APP_ENV=development
APP_PORT=4000
APP_VERSION=0.1.0
APP_URL=http://localhost:4000
API_PREFIX=/api/v1

DATABASE_URL=postgresql://collegeos_user:collegeos_password@localhost:5432/collegeos_db?schema=public
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false

JWT_ACCESS_SECRET=dev_only_insecure_jwt_access_secret_1234567890
JWT_REFRESH_SECRET=dev_only_insecure_jwt_refresh_secret_1234567890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://127.0.0.1:3000
LOG_LEVEL=debug
LOG_FORMAT=pretty

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

ANDROID_API_BASE_URL=http://10.0.2.2:4000/api/v1/
